# EDA exports keep their original line endings (no CRLF<->LF normalization),
# but stay diffable as text.
*.net -text
*.tel -text

# Fabrication bundles and EasyEDA project archives are binary.
*.zip binary
*.epro2 binary

# Shell scripts ALWAYS check out with LF, on every platform. The release build runs
# tools/build-release.sh on an Ubuntu runner; a CRLF checkout (which a Windows dev box
# with core.autocrlf=true would otherwise produce) makes bash fail on the shebang line.
*.sh text eol=lf
