#: import RetroProgressBar dro.components.widgets.progress_bar.RetroProgressBar
#: import ButtonItem dro.components.widgets.button_item

# ADVANCED page — reached from Update > Advanced, not from the main navigation.
# No release picker here on purpose: firmware version follows the installed software's
# release, so offering an independent choice would only let a user build a mismatch.

<BankToggle@ToggleButton>:
  group: "bootbank"
  allow_no_selection: False
  font_size: app.formats.font_size

<FirmwareScreen>:
  BoxLayout:
    orientation: "vertical"
    padding: 10

    ScreenHeader:
      text: "Firmware (advanced)"

    ScrollView:
      do_scroll_x: False
      do_scroll_y: True
      GridLayout:
        cols: 1
        spacing: 1
        size_hint_y: None
        height: self.minimum_height

        # ── Status ──────────────────────────────────────────────
        TitleItem:
          name: "Versions"
        ButtonItem:
          height: 60
          name: "Board firmware"
          value: root.current_version
          on_release: root.refresh_status()
        ButtonItem:
          height: 60
          name: "Installed software"
          value: root.software_version
        ButtonItem:
          height: 60
          name: "Currently active bank"
          value: root.active_bank_text
          on_release: root.refresh_status()

        # ── Staged image (left by an interrupted stack update) ──
        TitleItem:
          name: "Staged update"
        ButtonItem:
          height: 60
          name: "Firmware staged for"
          value: root.staged_version if root.staged_version else "none"
        BoxLayout:
          size_hint_y: None
          height: 60
          padding: 4
          Button:
            text: "Flash Staged Image" if not root.busy else "Flashing…"
            disabled: root.busy or not root.staged_version
            font_size: app.formats.font_size
            on_release: root.flash_staged()

        # ── Boot selection ──────────────────────────────────────
        TitleItem:
          name: "Boot selection"
        BoxLayout:
          size_hint_y: None
          height: 60
          Widget:
            size_hint_x: None
            width: 60
          Label:
            size_hint_x: 0.7
            text: "Boot bank (next reboot)"
            font_size: app.formats.font_size
          BoxLayout:
            size_hint_x: None
            width: 250
            spacing: 2
            BankToggle:
              text: "Bank 0"
              state: "down" if root.boot_bank == "0" else "normal"
              disabled: root.busy
              on_release: root.set_bank("0")
            BankToggle:
              text: "Bank 1"
              state: "down" if root.boot_bank == "1" else "normal"
              disabled: root.busy
              on_release: root.set_bank("1")
        ButtonItem:
          height: 60
          name: "Reboot firmware now"
          value: "Reset"
          on_release: root.do_reset()

        # ── Progress ────────────────────────────────────────────
        TitleItem:
          name: "Flash progress"
        RetroProgressBar:
          size_hint_y: None
          height: 30
          max: 1.0
          value: root.progress
          fill_color: app.formats.display_color

        # ── Activity log ────────────────────────────────────────
        TitleItem:
          name: "Activity log"
        TextInput:
          size_hint_y: None
          height: 160
          readonly: True
          multiline: True
          font_size: app.formats.font_size
          text: root.status_text
