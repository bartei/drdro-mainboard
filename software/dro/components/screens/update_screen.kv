#: import RetroProgressBar dro.components.widgets.progress_bar.RetroProgressBar

# User-facing update page: what you have, what's available, one button, progress.
# Everything a developer needs (raw logs, version pickers, bank control, manual firmware
# flashing) lives on the advanced firmware screen — deliberately not here.

<UpdateScreen>:
  formats: app.formats
  BoxLayout:
    orientation: "vertical"
    padding: 10
    spacing: 4

    ScreenHeader:
      text: "Update"

    ButtonItem:
      height: 60
      name: "Installed version"
      value: root.installed_version
      help_file: "software_update.md"

    ButtonItem:
      height: 60
      name: "Available version"
      value: root.available_version if root.available_version else "checking…"
      help_file: "software_update.md"
      on_release: root.check_for_updates()

    # Single action for the whole stack — software and firmware move together.
    Button:
      size_hint_y: None
      height: 80
      font_size: app.formats.font_size * 1.2
      disabled: root.busy or not root.update_available
      text:
        ("Updating…" if root.busy else \
        ("Update to " + root.available_version if root.update_available else "Up to date"))
      on_release: root.start_update()

    RetroProgressBar:
      size_hint_y: None
      height: 30
      max: 1.0
      value: root.progress
      fill_color: app.formats.display_color

    Label:
      size_hint_y: None
      height: 60
      font_size: app.formats.font_size
      color: app.formats.display_color
      text: root.status
      text_size: self.width, None
      halign: "center"
      valign: "middle"

    Widget:                                   # push the advanced link to the bottom

    Button:
      size_hint_y: None
      height: 50
      font_size: app.formats.font_size * 0.8
      text: "Advanced…"
      disabled: root.busy
      on_release: root.goto_advanced()
